<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
  dir="{{ request.locale.direction | default: 'ltr' }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {%- render 'view-transition-opt-in' -%}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'card-hover-effect-styles' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    <style>
      /* Nexa: the "zoomed out" grid-view title overlay isn't part of this design
         and can get stuck on via a stale sessionStorage value from earlier
         testing, independent of the enable_grid_density setting. Force it off. */
      .product-grid-view-zoom-out--details {
        display: none !important;
      }

      /* Nexa: lift product cards on hover so the catalog grid feels premium
         instead of static, matching the rest of the site's interactions. */
      .product-card {
        transition: transform 0.25s ease;
      }
      .product-card:hover {
        transform: translateY(-4px);
      }
      .product-card:hover .product-grid__card {
        box-shadow: 0 16px 36px rgba(124, 58, 237, 0.2), 0 4px 12px rgba(0, 0, 0, 0.45);
      }
      @media (prefers-reduced-motion: reduce) {
        .product-card {
          transition: none;
        }
        .product-card:hover {
          transform: none;
        }
      }

      /* Nexa: give the collection filter/sort toolbar a visible bottom edge so
         it reads as a distinct bar instead of floating loosely above the grid. */
      .facets-controls-wrapper {
        padding-bottom: 1.25rem;
        margin-bottom: 0.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      /* Nexa: found the real cause of the "sticky image" complaint — the
         theme's product-media-gallery-content snippet unconditionally puts
         a `sticky-content` class on <media-gallery> itself (position:
         sticky; top: 0), completely separate from the sticky_details_desktop
         setting we already turned off. That's what was pinning the image in
         place while the details column scrolled normally. Cancel it so the
         image scrolls inline with the details box like everything else. */
      @media screen and (min-width: 750px) {
        [data-template="product"] media-gallery.sticky-content {
          position: static;
          /* The theme also gives .sticky-content a negative top margin on a
             page's first section (to make sticky content hug the header) —
             with position back to static that just pulls the image upward
             relative to the details column instead. Neutralize it so both
             columns start at the same line. */
          margin-top: 0;
        }

        /* Guessing the details card's rendered padding in px to offset the
           image against it (33px flat, then a plain center) kept missing —
           it's computed via the theme's spacing-scale variable, not a fixed
           number. Redesigned instead of patching further: give the image
           the same bordered/background card treatment already used for the
           details box, product cards, and contact panels elsewhere on the
           site. With identical border + padding on both, their content
           starts at the same inset from a shared top line by construction —
           nothing left to measure or guess. */
        [data-template="product"] .product-information__media {
          align-self: start;
        }

        /* The card styling lives on <media-gallery> itself, not the
           .product-information__media wrapper div — that wrapper has a
           native `width: 0; min-width: 100%;` sizing hack which overrides
           any max-width we set on it (min-width always wins), which is why
           the box ignored our cap and ballooned past its own border. */
        [data-template="product"] media-gallery {
          display: block;
          box-sizing: border-box;
          width: 100%;
          max-width: 640px;
          margin-inline: auto;
          border: 1px solid rgba(255, 255, 255, 0.08);
          border-radius: 20px;
          background: #140e1d;
          padding: 32px;
          overflow: hidden;
        }
      }

      /* Nexa: brand the sidebar filter group labels (Availability, Price)
         to match the eyebrow typography used across the rest of the site. */
      [data-template="collection"] .facets--vertical .facets__label {
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        font-size: 0.8125rem;
      }

      /* Nexa: the collection grid was capped at the same 1440px page-width as
         marketing sections, so on wide screens the sidebar filter sat ~240px+
         in from the actual browser edge. Give this page a wider container —
         still centered with real margins, not edge-to-edge (that read as the
         filter being jammed against the wall) — and stop the filter column
         itself from ballooning to a third of that width for just two groups. */
      @media screen and (min-width: 990px) {
        [data-template="collection"] .collection-wrapper {
          --page-width: 1800px;
        }
      }

      [data-template="collection"] .facets-block-wrapper--vertical {
        max-width: 220px;
      }
    </style>

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% render 'chat-drawer' %}

    <div class="page-wrapper">
      <div id="header-group">
        {% sections 'header-group' %}
      </div>

      <script>
        window.measureHeaderHeights = (function () {
          let measured = false;

          return function measureHeaderHeights() {
            if (measured) return;

            const header = document.querySelector('#header-component');
            const headerGroup = document.querySelector('#header-group');

            if (!header || !headerGroup) return;
            measured = true;

            const headerHeight = header.offsetHeight;

            let headerGroupHeight = 0;
            for (const element of headerGroup.children) {
              if (element instanceof HTMLElement) headerGroupHeight += element.offsetHeight;
            }

            if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
              headerGroupHeight += headerHeight;
            }

            document.body.style.setProperty('--header-height', `${headerHeight}px`);
            document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);
          };
        })();

        if (document.querySelector('#header-component')?.hasAttribute('transparent')) {
          measureHeaderHeights();
        }

        (function setTopRowHeight() {
          const header = document.querySelector('#header-component');
          const headerTopRow = header?.querySelector('.header__row--top');
          if (!headerTopRow) return;

          window.requestAnimationFrame(function () {
            header.style.setProperty('--top-row-height', `${headerTopRow.getBoundingClientRect().height}px`);
          });
        })();

        (function updateTransparentHeaderOffset() {
          const header = document.querySelector('#header-component');
          const headerSection = document.querySelector('#header-group .header-section');
          if (!headerSection || !header?.hasAttribute('transparent')) return;

          const hasImmediateSection = headerSection.nextElementSibling?.classList.contains('shopify-section');
          if (!hasImmediateSection) {
            document.body.style.setProperty('--transparent-header-offset-boolean', '1');
          }
        })();

        (function setHeaderMenuStyle() {
          const headerComponent = document.querySelector('#header-component');
          if (headerComponent) {
            const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
            const overflowList = headerComponent.querySelector('overflow-list');
            const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
            headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
          }
        })();
      </script>

      <main
        id="MainContent"
        class="content-for-layout"
        role="main"
        data-page-transition-enabled="{{ settings.page_transition_enabled }}"
        data-product-transition="{{ settings.transition_to_main_product }}"
        data-template="{{ template }}"
      >
        {{ content_for_layout }}
      </main>

      <footer>
        {% sections 'footer-group' %}
      </footer>
    </div>

    {% render 'cart-drawer', render_wrapper: true %}
    {% render 'theme-drawer' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  </body>
</html>
