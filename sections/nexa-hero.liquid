{% liquid
  assign bg_image = section.settings.background_image
%}

<section class="nexa-hero" data-testid="nexa-hero">
  {% if bg_image %}
    {{
      bg_image
      | image_url: width: 3840
      | image_tag:
        widths: '750, 1100, 1500, 2000, 3000, 3840',
        sizes: '100vw',
        class: 'nexa-hero__image',
        alt: bg_image.alt | default: section.settings.heading,
        loading: 'eager',
        fetchpriority: 'high'
    }}
  {% endif %}
  <div class="nexa-hero__overlay"></div>

  <div class="nexa-hero__content">
    {% if section.settings.eyebrow != blank %}
      <p class="nexa-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="nexa-hero__heading">{{ section.settings.heading }}</h1>
    {% endif %}
    {% if section.settings.body != blank %}
      <p class="nexa-hero__body">{{ section.settings.body }}</p>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a
        href="{{ section.settings.button_link | default: '#' }}"
        class="nexa-hero__button"
      >
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .nexa-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 78svh;
    padding: 2.5rem clamp(1.25rem, 6vw, 6rem);
    overflow: hidden;
    background: #0a0710;
  }

  .nexa-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .nexa-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse at 30% 60%, rgba(147, 51, 234, 0.22) 0%, transparent 55%),
      linear-gradient(to top, rgba(5, 3, 8, 0.95) 0%, rgba(10, 7, 16, 0.65) 50%, rgba(10, 7, 16, 0.4) 100%);
  }

  .nexa-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 720px;
  }

  .nexa-hero__eyebrow {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c084fc;
  }

  .nexa-hero__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(3.5rem, 9vw, 8rem);
    line-height: 0.94;
    letter-spacing: -0.03em;
    color: #ffffff;
  }

  .nexa-hero__body {
    margin: 0;
    max-width: 460px;
    font-family: var(--font-body--family);
    font-size: 1.25rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.75);
  }

  .nexa-hero__button {
    display: inline-flex;
    align-items: center;
    margin-top: 0.75rem;
    padding: 1rem 2.25rem;
    border-radius: 999px;
    background: #9333ea;
    color: #ffffff;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .nexa-hero__button:hover {
    background: #7e22ce;
  }

  @media screen and (max-width: 749px) {
    .nexa-hero {
      min-height: 72svh;
      padding: 2rem 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nexa hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "PREMIUM PERFORMANCE ESSENTIALS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built to move."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "For athletes and creators who push limits. Premium quality, modern design."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Nexa hero"
    }
  ]
}
{% endschema %}
