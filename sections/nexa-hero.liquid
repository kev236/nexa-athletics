{% liquid
  assign bg_image = section.settings.background_image
%}

<section class="nexa-hero-wrap" data-testid="nexa-hero">
  <div class="nexa-hero">
    {% if bg_image %}
      {{
        bg_image
        | image_url: width: 3840
        | image_tag:
          widths: '750, 1100, 1500, 2000, 3000, 3840',
          sizes: '100vw',
          class: 'nexa-hero__image',
          alt: bg_image.alt | default: section.settings.heading,
          loading: 'eager',
          fetchpriority: 'high'
      }}
    {% endif %}
    <div class="nexa-hero__overlay"></div>

    <div class="nexa-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="nexa-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h1 class="nexa-hero__heading">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.body != blank %}
        <p class="nexa-hero__body">{{ section.settings.body }}</p>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="nexa-hero__button"
        >
          {{ section.settings.button_label }}
          <span aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .nexa-hero-wrap {
    background: #0a0710;
  }

  .nexa-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    padding: 2rem clamp(1.5rem, 4vw, 4rem) 4rem;
    overflow: hidden;
    background: #120d1a;
  }

  .nexa-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .nexa-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse at 25% 70%, rgba(147, 51, 234, 0.28) 0%, transparent 55%),
      linear-gradient(to top, rgba(5, 3, 8, 0.9) 0%, rgba(10, 7, 16, 0.45) 45%, rgba(10, 7, 16, 0.15) 100%);
  }

  .nexa-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.875rem;
    max-width: 560px;
  }

  .nexa-hero__eyebrow {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  .nexa-hero__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 800;
    font-size: clamp(2.75rem, 6vw, 5rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .nexa-hero__body {
    margin: 0;
    max-width: 420px;
    font-family: var(--font-body--family);
    font-size: 1rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.75);
  }

  .nexa-hero__button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.875rem 1.75rem;
    border-radius: 999px;
    background: #9333ea;
    color: #ffffff;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .nexa-hero__button:hover {
    background: #7e22ce;
  }

  @media screen and (max-width: 749px) {
    .nexa-hero {
      /* A near-full-viewport-height box (92svh) forces object-fit: cover to crop a
         landscape photo down to a narrow vertical sliver on tall phone screens.
         Bound it to a portrait-friendly ratio instead so the crop stays reasonable. */
      min-height: 0;
      aspect-ratio: 4 / 5;
      max-height: 640px;
      padding: 1.5rem 1.25rem 2rem;
    }

    .nexa-hero__content {
      max-width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nexa hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Premium performance essentials"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built to move."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "For athletes and creators who push limits. Premium quality, modern design."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Nexa hero"
    }
  ]
}
{% endschema %}
