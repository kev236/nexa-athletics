{% liquid
  if section.settings.collection != blank
    assign source_collection = section.settings.collection
    assign source_products = source_collection.products
  else
    assign source_products = collections.all.products
  endif

  assign product_limit = section.settings.product_limit
%}

<section class="nexa-essentials" data-testid="nexa-essentials">
  <div class="nexa-essentials__header">
    <div class="nexa-essentials__heading-group">
      {% if section.settings.eyebrow != blank %}
        <p class="nexa-essentials__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="nexa-essentials__heading">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>
    {% if section.settings.view_all_link != blank %}
      <a href="{{ section.settings.view_all_link }}" class="nexa-essentials__view-all">
        {{ section.settings.view_all_label }}
        <span aria-hidden="true">&rarr;</span>
      </a>
    {% endif %}
  </div>

  {% if source_products.size > 0 %}
    <div class="nexa-essentials__grid">
      {% for product in source_products limit: product_limit %}
        <a href="{{ product.url }}" class="nexa-essentials__card">
          <div class="nexa-essentials__card-image">
            {% if section.settings.show_new_badge %}
              <span class="nexa-essentials__badge">New</span>
            {% endif %}
            {% if product.featured_image %}
              {{
                product.featured_image
                | image_url: width: 1200
                | image_tag:
                  widths: '360, 540, 720, 1200',
                  sizes: '(min-width: 990px) 25vw, 50vw',
                  alt: product.featured_image.alt | default: product.title,
                  loading: 'lazy',
                  class: 'nexa-essentials__card-image-primary'
              }}
            {% endif %}
            {% if product.media[1] %}
              {{
                product.media[1]
                | image_url: width: 1200
                | image_tag:
                  widths: '360, 540, 720, 1200',
                  sizes: '(min-width: 990px) 25vw, 50vw',
                  alt: product.media[1].alt | default: product.title,
                  loading: 'lazy',
                  class: 'nexa-essentials__card-image-secondary'
              }}
            {% endif %}
          </div>
          <div class="nexa-essentials__card-info">
            <p class="nexa-essentials__card-title">{{ product.title }}</p>
            <p class="nexa-essentials__card-price">{{ product.price | money }}</p>
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="nexa-essentials__empty">
      <p>New pieces are on the way — check back soon.</p>
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .nexa-essentials {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding: 3.5rem clamp(1.25rem, 4vw, 3rem);
    background: #0a0710;
  }

  .nexa-essentials__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .nexa-essentials__heading-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .nexa-essentials__eyebrow {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .nexa-essentials__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 800;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    letter-spacing: -0.01em;
    color: #ffffff;
  }

  .nexa-essentials__view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    font-weight: 600;
    color: #c084fc;
    text-decoration: none;
    white-space: nowrap;
  }

  .nexa-essentials__view-all:hover {
    color: #d8b4fe;
  }

  .nexa-essentials__grid {
    display: grid;
    /* minmax(0, 1fr), not bare 1fr — see nexa-category-grid.liquid for why
       a bare 1fr track can grow past its equal share. */
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .nexa-essentials__card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    text-decoration: none;
    color: inherit;
  }

  .nexa-essentials__card-image {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 14px;
    background: #120d1a;
  }

  .nexa-essentials__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 1;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: #9333ea;
    color: #ffffff;
    font-family: var(--font-body--family);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .nexa-essentials__card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease, opacity 0.35s ease;
  }

  /* Swap to the second product photo on hover, when one exists. Kept as the
     only hover effect here — combined with a zoom it felt like too much
     happening at once. */
  .nexa-essentials__card-image-secondary {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .nexa-essentials__card:hover .nexa-essentials__card-image-primary {
    opacity: 0;
  }

  .nexa-essentials__card:hover .nexa-essentials__card-image-secondary {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .nexa-essentials__card-image img {
      transition: none;
    }
  }

  .nexa-essentials__card-info {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .nexa-essentials__card-title {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    color: #ffffff;
  }

  .nexa-essentials__card-price {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.65);
  }

  .nexa-essentials__empty {
    padding: 2.5rem 0;
    font-family: var(--font-body--family);
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.6);
  }

  @media screen and (max-width: 989px) {
    .nexa-essentials__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .nexa-essentials {
      padding: 2.5rem 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nexa essentials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Featured products"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Essentials"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all products"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "checkbox",
      "id": "show_new_badge",
      "label": "Show \"New\" badge on cards",
      "default": true
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave blank to pull from all products"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Nexa essentials"
    }
  ]
}
{% endschema %}
