<section class="nexa-banner-wrap" data-testid="nexa-collection-header">
  <div class="nexa-banner">
    {% if section.settings.image %}
      {{
        section.settings.image
        | image_url: width: 1600
        | image_tag:
          widths: '480, 800, 1200, 1600',
          sizes: '(min-width: 750px) 50vw, 100vw',
          class: 'nexa-banner__image',
          alt: section.settings.image.alt | default: closest.collection.title,
          loading: 'eager'
      }}
      <div class="nexa-banner__overlay"></div>
    {% endif %}
    <div class="nexa-banner__content">
      {% if section.settings.eyebrow != blank %}
        <p class="nexa-banner__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h1 class="nexa-banner__title">{{ closest.collection.title }}</h1>
      {% if closest.collection.description != blank %}
        <div class="nexa-banner__description">{{ closest.collection.description }}</div>
      {% elsif section.settings.fallback_description != blank %}
        <p class="nexa-banner__description">{{ section.settings.fallback_description }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .nexa-banner-wrap {
    background: #0a0710;
  }

  .nexa-banner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    height: clamp(320px, 36vw, 480px);
    overflow: hidden;
    background: #120d1a;
  }

  .nexa-banner__image {
    grid-column: 2;
    grid-row: 1;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 12%;
  }

  .nexa-banner__overlay {
    grid-column: 2;
    grid-row: 1;
    background: linear-gradient(to right, rgba(10, 7, 16, 0.5) 0%, transparent 30%);
  }

  .nexa-banner__content {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.75rem;
    padding: 2.5rem clamp(1.5rem, 3vw, 3rem);
  }

  .nexa-banner__eyebrow {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .nexa-banner__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .nexa-banner__description {
    margin: 0;
    max-width: 420px;
    font-family: var(--font-body--family);
    font-size: 1rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.65);
  }

  @media screen and (max-width: 749px) {
    .nexa-banner {
      grid-template-columns: 1fr;
      height: auto;
    }

    .nexa-banner__image {
      grid-column: 1;
      grid-row: 1;
      position: static;
      inset: auto;
      height: 220px;
      order: 1;
    }

    .nexa-banner__overlay {
      display: none;
    }

    .nexa-banner__content {
      grid-column: 1;
      grid-row: 2;
      order: 2;
      padding: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nexa collection header",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "fallback_description",
      "label": "Fallback description",
      "info": "Shown only when the collection itself has no description set",
      "default": "Premium performance wear for every move."
    }
  ],
  "presets": [
    {
      "name": "Nexa collection header"
    }
  ]
}
{% endschema %}
