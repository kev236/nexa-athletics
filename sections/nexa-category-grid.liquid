{% liquid
  assign handles = section.settings.collection_handles | split: ','
%}

<section class="nexa-category-grid" data-testid="nexa-category-grid">
  {% if section.settings.heading != blank %}
    <h2 class="nexa-category-grid__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="nexa-category-grid__grid">
    {% for handle in handles %}
      {% assign handle = handle | strip %}
      {% assign coll = collections[handle] %}
      {% if coll != blank %}
        <a href="{{ coll.url }}" class="nexa-category-grid__card">
          {% if coll.featured_image %}
            {{
              coll.featured_image
              | image_url: width: 1000
              | image_tag:
                widths: '400, 600, 800, 1000',
                sizes: '(min-width: 750px) 50vw, 100vw',
                alt: coll.featured_image.alt | default: coll.title,
                loading: 'lazy'
            }}
          {% endif %}
          <div class="nexa-category-grid__overlay"></div>
          <p class="nexa-category-grid__title">{{ coll.title }}</p>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .nexa-category-grid {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding: 3.5rem clamp(1.25rem, 4vw, 3rem);
    background: #050308;
  }

  .nexa-category-grid__heading {
    margin: 0 0 1.5rem;
    font-family: var(--font-heading--family);
    font-weight: 800;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    letter-spacing: -0.01em;
    color: #ffffff;
  }

  .nexa-category-grid__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .nexa-category-grid__card {
    position: relative;
    display: flex;
    align-items: flex-end;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid rgba(147, 51, 234, 0.2);
    background: #120d1a;
    text-decoration: none;
  }

  .nexa-category-grid__card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nexa-category-grid__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(5, 3, 8, 0.85) 0%, rgba(5, 3, 8, 0.1) 55%, transparent 100%);
  }

  .nexa-category-grid__title {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 1.5rem;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    color: #ffffff;
  }

  @media screen and (max-width: 749px) {
    .nexa-category-grid {
      padding: 2.5rem 1.25rem;
    }

    .nexa-category-grid__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nexa category grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "collection_handles",
      "label": "Collection handles",
      "info": "Comma-separated collection handles, e.g. t-shirts,hoodies",
      "default": "t-shirts,hoodies,leggings-shorts,accessories"
    }
  ],
  "presets": [
    {
      "name": "Nexa category grid"
    }
  ]
}
{% endschema %}
