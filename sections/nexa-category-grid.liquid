{% liquid
  assign handles = section.settings.collection_handles | split: ','
%}

<section class="nexa-category-grid" data-testid="nexa-category-grid">
  <div class="nexa-category-grid__header">
    {% if section.settings.eyebrow != blank %}
      <p class="nexa-category-grid__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="nexa-category-grid__heading">{{ section.settings.heading }}</h2>
    {% endif %}
  </div>

  <div class="nexa-category-grid__grid">
    {% for handle in handles %}
      {% assign handle = handle | strip %}
      {% assign coll = collections[handle] %}
      {% if coll != blank %}
        <a href="{{ coll.url }}" class="nexa-category-grid__card">
          {% if coll.featured_image %}
            {{
              coll.featured_image
              | image_url: width: 1000
              | image_tag:
                widths: '400, 600, 800, 1000',
                sizes: '(min-width: 750px) 50vw, 100vw',
                alt: coll.featured_image.alt | default: coll.title,
                loading: 'lazy',
                class: 'nexa-category-grid__image'
            }}
          {% endif %}
          <div class="nexa-category-grid__overlay"></div>
          <div class="nexa-category-grid__content">
            <div class="nexa-category-grid__text">
              <p class="nexa-category-grid__title">{{ coll.title }}</p>
              <p class="nexa-category-grid__count">
                {{ coll.products_count }}
                {% if coll.products_count == 1 %}product{% else %}products{% endif %}
              </p>
            </div>
            <span class="nexa-category-grid__arrow" aria-hidden="true">&rarr;</span>
          </div>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .nexa-category-grid {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding: 3.5rem clamp(1.25rem, 4vw, 3rem);
    background: #050308;
  }

  .nexa-category-grid__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0 0 1.75rem;
  }

  .nexa-category-grid__eyebrow {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .nexa-category-grid__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 800;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .nexa-category-grid__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .nexa-category-grid__card {
    position: relative;
    display: flex;
    align-items: flex-end;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid rgba(147, 51, 234, 0.35);
    background: #1c1428;
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.4);
    text-decoration: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }

  .nexa-category-grid__card:hover {
    border-color: rgba(147, 51, 234, 0.6);
    box-shadow: 0 20px 44px rgba(124, 58, 237, 0.28), 0 4px 14px rgba(0, 0, 0, 0.45);
    transform: translateY(-4px);
  }

  .nexa-category-grid__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(1.2) contrast(1.05);
    transition: transform 0.5s ease;
  }

  .nexa-category-grid__card:hover .nexa-category-grid__image {
    transform: scale(1.06);
  }

  .nexa-category-grid__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(5, 3, 8, 0.85) 0%, rgba(5, 3, 8, 0.45) 32%, transparent 70%);
  }

  .nexa-category-grid__content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 1.5rem;
  }

  .nexa-category-grid__text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nexa-category-grid__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.01em;
    color: #ffffff;
  }

  .nexa-category-grid__count {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .nexa-category-grid__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(5, 3, 8, 0.4);
    color: #ffffff;
    font-size: 1.125rem;
    transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  .nexa-category-grid__card:hover .nexa-category-grid__arrow {
    background: #9333ea;
    border-color: #9333ea;
    transform: translateX(2px);
  }

  @media screen and (max-width: 749px) {
    .nexa-category-grid {
      padding: 2.5rem 1.25rem;
    }

    .nexa-category-grid__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nexa category grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Categories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "collection_handles",
      "label": "Collection handles",
      "info": "Comma-separated collection handles, e.g. t-shirts,hoodies",
      "default": "t-shirts,hoodies,leggings-shorts,accessories"
    }
  ],
  "presets": [
    {
      "name": "Nexa category grid"
    }
  ]
}
{% endschema %}
