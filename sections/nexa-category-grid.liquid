{% liquid
  assign handles = section.settings.collection_handles | split: ','
%}

<section class="nexa-category-grid" data-testid="nexa-category-grid">
  <div class="nexa-category-grid__header">
    {% if section.settings.eyebrow != blank %}
      <p class="nexa-category-grid__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="nexa-category-grid__heading">{{ section.settings.heading }}</h2>
    {% endif %}
  </div>

  <div class="nexa-category-grid__grid">
    {% for handle in handles %}
      {% assign handle = handle | strip %}
      {% assign coll = collections[handle] %}
      {% if coll != blank %}
        <a href="{{ coll.url }}" class="nexa-category-grid__card">
          <div class="nexa-category-grid__card-image">
            {% if coll.featured_image %}
              {{
                coll.featured_image
                | image_url: width: 1200
                | image_tag:
                  widths: '360, 540, 720, 1200',
                  sizes: '(min-width: 990px) 25vw, (min-width: 550px) 50vw, 100vw',
                  alt: coll.featured_image.alt | default: coll.title,
                  loading: 'lazy'
              }}
            {% endif %}
          </div>
          <div class="nexa-category-grid__card-info">
            <div class="nexa-category-grid__card-text">
              <p class="nexa-category-grid__card-title">{{ coll.title }}</p>
              <p class="nexa-category-grid__card-count">
                {{ coll.products_count }}
                {% if coll.products_count == 1 %}product{% else %}products{% endif %}
              </p>
            </div>
            <span class="nexa-category-grid__card-arrow" aria-hidden="true">&rarr;</span>
          </div>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .nexa-category-grid {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding: 3.5rem clamp(1.25rem, 4vw, 3rem);
    background: #0a0710;
  }

  .nexa-category-grid__header {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0 0 2rem;
  }

  .nexa-category-grid__eyebrow {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .nexa-category-grid__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 800;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    letter-spacing: -0.01em;
    color: #ffffff;
  }

  .nexa-category-grid__grid {
    display: grid;
    /* minmax(0, 1fr), not bare 1fr — a bare 1fr track's minimum is its
       content's min-content width, so a card with a longer title (e.g.
       "Leggings & Shorts") could grow its own column wider than the rest
       instead of every column sharing the row equally. */
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .nexa-category-grid__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .nexa-category-grid__card-image {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: #120d1a;
  }

  .nexa-category-grid__card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .nexa-category-grid__card:hover .nexa-category-grid__card-image img {
    transform: scale(1.06);
  }

  .nexa-category-grid__card:hover .nexa-category-grid__card-image {
    border-color: rgba(147, 51, 234, 0.5);
  }

  .nexa-category-grid__card-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.875rem 0.125rem 0;
  }

  .nexa-category-grid__card-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .nexa-category-grid__card-title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    color: #ffffff;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nexa-category-grid__card-count {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .nexa-category-grid__card-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    font-size: 1rem;
    transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  .nexa-category-grid__card:hover .nexa-category-grid__card-arrow {
    background: #9333ea;
    border-color: #9333ea;
    transform: translateX(2px);
  }

  @media screen and (max-width: 989px) {
    .nexa-category-grid__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .nexa-category-grid {
      padding: 2.5rem 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nexa category grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Categories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "collection_handles",
      "label": "Collection handles",
      "info": "Comma-separated collection handles, e.g. t-shirts,hoodies",
      "default": "t-shirts,hoodies,leggings-shorts,accessories"
    }
  ],
  "presets": [
    {
      "name": "Nexa category grid"
    }
  ]
}
{% endschema %}
