<section class="nexa-values" data-testid="nexa-values">
  <div class="nexa-values__text">
    {% if section.settings.eyebrow != blank %}
      <p class="nexa-values__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="nexa-values__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.body != blank %}
      <p class="nexa-values__body">{{ section.settings.body }}</p>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link | default: '#' }}" class="nexa-values__button">
        {{ section.settings.button_label }}
        <span aria-hidden="true">&rarr;</span>
      </a>
    {% endif %}
  </div>

  <div class="nexa-values__badges">
    {% for block in section.blocks %}
      <div class="nexa-values__badge" {{ block.shopify_attributes }}>
        <span class="nexa-values__badge-icon">
          {%- render 'icon-or-image', icon: block.settings.icon, width: 26 -%}
        </span>
        <p class="nexa-values__badge-label">{{ block.settings.label }}</p>
        {% if block.settings.caption != blank %}
          <p class="nexa-values__badge-caption">{{ block.settings.caption }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .nexa-values {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: center;
    gap: 3rem;
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding: 4rem clamp(1.25rem, 4vw, 3rem);
    background:
      radial-gradient(ellipse at 80% 30%, rgba(147, 51, 234, 0.12) 0%, transparent 60%),
      #0a0710;
  }

  .nexa-values__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.875rem;
    max-width: 420px;
  }

  .nexa-values__eyebrow {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .nexa-values__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 800;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .nexa-values__body {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.65);
  }

  .nexa-values__button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    border: 1px solid #9333ea;
    background: transparent;
    color: #c084fc;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .nexa-values__button:hover {
    background: rgba(147, 51, 234, 0.12);
  }

  .nexa-values__badges {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .nexa-values__badge {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .nexa-values__badge-icon {
    display: flex;
    color: #9333ea;
  }

  .nexa-values__badge-icon svg {
    width: 26px;
    height: 26px;
  }

  .nexa-values__badge-label {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .nexa-values__badge-caption {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.55);
  }

  @media screen and (max-width: 989px) {
    .nexa-values {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media screen and (max-width: 749px) {
    .nexa-values {
      padding: 2.5rem 1.25rem;
    }

    .nexa-values__badges {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nexa values",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our values"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More than just clothing."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Nexa Athletics is built for those who push limits. Premium quality. Modern design. Real performance."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "lightning_bolt", "label": "Lightning bolt" },
            { "value": "lock", "label": "Lock" },
            { "value": "star", "label": "Star" },
            { "value": "stopwatch", "label": "Stopwatch" },
            { "value": "shoe", "label": "Shoe" },
            { "value": "shirt", "label": "Shirt" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "lightning_bolt"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Performance driven"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Engineered for movement."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nexa values",
      "blocks": [
        { "type": "badge", "settings": { "icon": "lightning_bolt", "label": "Performance driven", "caption": "Engineered for movement." } },
        { "type": "badge", "settings": { "icon": "lock", "label": "Premium quality", "caption": "Materials that last." } },
        { "type": "badge", "settings": { "icon": "stopwatch", "label": "Built for athletes", "caption": "From gym to everyday." } }
      ]
    }
  ]
}
{% endschema %}
