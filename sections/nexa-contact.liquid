<section class="nexa-contact" data-testid="nexa-contact">
  <div class="nexa-contact__header">
    {% if section.settings.eyebrow != blank %}
      <p class="nexa-contact__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1 class="nexa-contact__title">{{ section.settings.title }}</h1>
    {% if section.settings.body != blank %}
      <p class="nexa-contact__body">{{ section.settings.body }}</p>
    {% endif %}
  </div>

  <div class="nexa-contact__grid">
    <div class="nexa-contact__form-wrap">
      {%- form 'contact', id: 'NexaContactForm', class: 'nexa-contact__form' -%}
        {%- if form.errors -%}
          <div class="nexa-contact__message nexa-contact__message--error" tabindex="-1" autofocus>
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <div class="nexa-contact__message nexa-contact__message--success" tabindex="-1" autofocus>
            Thanks — your message has been sent. We'll get back to you soon.
          </div>
        {%- endif -%}

        <div class="nexa-contact__row">
          <label class="visually-hidden" for="NexaContactForm-name">Name</label>
          <input
            type="text"
            id="NexaContactForm-name"
            class="nexa-contact__input"
            autocomplete="name"
            name="contact[name]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="Name"
          >
          <label class="visually-hidden" for="NexaContactForm-email">Email</label>
          <input
            type="email"
            id="NexaContactForm-email"
            class="nexa-contact__input"
            autocomplete="email"
            name="contact[email]"
            spellcheck="false"
            autocapitalize="off"
            required
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            placeholder="Email *"
          >
        </div>

        <label class="visually-hidden" for="NexaContactForm-body">Message</label>
        <textarea
          rows="7"
          id="NexaContactForm-body"
          class="nexa-contact__input nexa-contact__input--textarea"
          name="contact[body]"
          placeholder="Message"
        >{{- form.body -}}</textarea>

        <button type="submit" class="nexa-contact__submit">Send message</button>
      {%- endform -%}
    </div>

    <div class="nexa-contact__info">
      {% if section.settings.info_eyebrow != blank %}
        <p class="nexa-contact__info-eyebrow">{{ section.settings.info_eyebrow }}</p>
      {% endif %}
      {% if section.settings.email != blank %}
        <a href="mailto:{{ section.settings.email }}" class="nexa-contact__info-row">
          <span class="nexa-contact__info-icon">{%- render 'icon-or-image', icon: 'chat_bubble', width: 22 -%}</span>
          <span>
            Email<br>
            {{ section.settings.email }}
          </span>
        </a>
      {% endif %}

      {% if section.settings.follow_eyebrow != blank %}
        <p class="nexa-contact__info-eyebrow nexa-contact__info-eyebrow--follow">{{ section.settings.follow_eyebrow }}</p>
      {% endif %}
      <div class="nexa-contact__socials">
        {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}" class="nexa-contact__social-link">Instagram</a>
        {% endif %}
        {% if section.settings.tiktok_url != blank %}
          <a href="{{ section.settings.tiktok_url }}" class="nexa-contact__social-link">TikTok</a>
        {% endif %}
        {% if section.settings.facebook_url != blank %}
          <a href="{{ section.settings.facebook_url }}" class="nexa-contact__social-link">Facebook</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .nexa-contact {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding: 4.5rem clamp(1.25rem, 6vw, 6rem) 6rem;
    background: #0a0710;
  }

  .nexa-contact__header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 640px;
    margin-bottom: 3.5rem;
  }

  .nexa-contact__eyebrow {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #c084fc;
  }

  .nexa-contact__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .nexa-contact__body {
    margin: 0;
    max-width: 480px;
    font-family: var(--font-body--family);
    font-size: 1.125rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.7);
  }

  .nexa-contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 4rem;
  }

  .nexa-contact__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .nexa-contact__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .nexa-contact__input {
    width: 100%;
    padding: 0.875rem 1.125rem;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
    font-family: var(--font-body--family);
    font-size: 1rem;
  }

  .nexa-contact__input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .nexa-contact__input--textarea {
    resize: vertical;
    min-height: 160px;
  }

  .nexa-contact__submit {
    align-self: flex-start;
    margin-top: 0.5rem;
    padding: 1rem 2.25rem;
    border: none;
    border-radius: 999px;
    background: #9333ea;
    color: #ffffff;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .nexa-contact__submit:hover {
    background: #7e22ce;
  }

  .nexa-contact__message {
    padding: 1rem 1.25rem;
    border-radius: 10px;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
  }

  .nexa-contact__message--error {
    background: rgba(220, 38, 38, 0.12);
    border: 1px solid rgba(220, 38, 38, 0.4);
    color: #fca5a5;
  }

  .nexa-contact__message--success {
    background: rgba(147, 51, 234, 0.12);
    border: 1px solid rgba(147, 51, 234, 0.4);
    color: #d8b4fe;
  }

  .nexa-contact__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .nexa-contact__info-eyebrow {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .nexa-contact__info-eyebrow--follow {
    margin-top: 1.5rem;
  }

  .nexa-contact__info-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    font-family: var(--font-body--family);
    font-size: 1rem;
    line-height: 1.4;
  }

  .nexa-contact__info-icon {
    display: flex;
    color: #9333ea;
    flex-shrink: 0;
  }

  .nexa-contact__info-icon svg {
    width: 22px;
    height: 22px;
  }

  .nexa-contact__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }

  .nexa-contact__social-link {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
  }

  .nexa-contact__social-link:hover {
    color: #c084fc;
  }

  @media screen and (max-width: 989px) {
    .nexa-contact__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media screen and (max-width: 749px) {
    .nexa-contact {
      padding: 3rem 1.25rem 3.5rem;
    }

    .nexa-contact__row {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nexa contact",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CONTACT"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Let's connect."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Have a question, need support, or want to work together? Fill out the form and we'll get back to you as soon as possible."
    },
    {
      "type": "text",
      "id": "info_eyebrow",
      "label": "Info eyebrow",
      "default": "GET IN TOUCH"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "default": "kevin.mlocek2007@gmail.com"
    },
    {
      "type": "text",
      "id": "follow_eyebrow",
      "label": "Follow eyebrow",
      "default": "FOLLOW US"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    }
  ],
  "presets": [
    {
      "name": "Nexa contact"
    }
  ]
}
{% endschema %}
